{
	"format_version": "1.20.41",
	"minecraft:entity": {
		"description": {
			"identifier": "shapescape:shadow_entity",
			"is_spawnable": false,
			"is_summonable": true
		},
		"component_groups": {
			"shapescape:despawn": {
				"minecraft:instant_despawn": {}
			},
			"shapescape:check_for_ride": {
				"minecraft:environment_sensor": {
					"triggers": [
						{
							"event": "shapescape:despawn",
							"target": "self",
							"filters": {
								"test": "is_riding",
								"value": false
							}
						}
					]
				}
			}
		},
		"components": {
			"minecraft:physics": { "has_collision": true, "has_gravity": true },
			"minecraft:collision_box": { "width": 0.6, "height": 1.8 },
			"minecraft:damage_sensor": {
				"triggers": [{ "cause": "all", "deals_damage": false }]
			},
			"minecraft:type_family": {
				"family": ["shapescape_shadow"]
			},
			"minecraft:timer": {
				"time": 0.5,
				"looping": false,
				"time_down_event": {
					"event": "shapescape:check_for_ride",
					"target": "self"
				}
			}
		},
		"events": {
			"shapescape:despawn": {
				"add": {
					"component_groups": ["shapescape:despawn"]
				}
			},
			"shapescape:check_for_ride": {
				"add": {
					"component_groups": ["shapescape:check_for_ride"]
				}
			}
		}
	}
}
